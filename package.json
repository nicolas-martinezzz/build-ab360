{
  "name": "yutopias-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "npm run check:json-bom",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:palette": "node scripts/check-color-palette.mjs",
    "check:json-bom": "node scripts/check-json-bom.mjs",
    "check:i18n-parity": "node scripts/check-i18n-parity.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run lint:palette && npm run check:json-bom && npm run check:i18n-parity && npm run test && npm run build",
    "deploy": "node scripts/deploy-production.js",
    "ship": "node scripts/ship.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "gentle-pi": "^0.3.4",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "basic-ftp": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.0.0",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
